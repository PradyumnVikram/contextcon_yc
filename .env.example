# Copy to .env and fill in. Never commit .env.
# LLM: local Ollama by default. Set CLEARANCE_LLM=claude to use the Anthropic API instead.
CLEARANCE_LLM=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
CRUSTDATA_API_KEY=

# Optional overrides
CLEARANCE_DB=clearance.db
CLEARANCE_MAILBOX=mailbox
